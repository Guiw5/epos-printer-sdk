{
  "name": "epos-printer-sdk",
  "version": "0.2.0",
  "description": "Modern TypeScript library port of Epson's ePOS SDK, transcription from vendor's IIFE bundle. Ships EposHttpPrinter, a lightweight, socket-free, fully async/await client for the ePOS-Print HTTP web service (built for the TM-T88V), plus the full callback-based SDK surface (device management, WebSocket transport) for advanced use.",
  "keywords": [
    "epson",
    "epos",
    "epos-print",
    "epos-device",
    "pos-printer",
    "tm-printer",
    "tm-t88v",
    "thermal-printer",
    "receipt-printer",
    "printer",
    "printing",
    "pos",
    "point-of-sale",
    "typescript",
    "epos-sdk-javascript",
    "react",
    "client-side",
    "server-side",
    "node"
  ],
  "author": "Guido Wagner",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guiw5/epos-printer-sdk.git"
  },
  "homepage": "https://github.com/Guiw5/epos-printer-sdk#readme",
  "bugs": {
    "url": "https://github.com/Guiw5/epos-printer-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    },
    "./simulator": {
      "types": "./dist/simulator.d.ts",
      "default": "./dist/simulator.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.es.md",
    "llms.txt"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "docs": "typedoc --entryPoints src/index.ts --out docs",
    "dev:react": "pnpm --filter epos-printer-react-example dev",
    "build:react": "pnpm build && pnpm --filter epos-printer-react-example build",
    "test:react": "pnpm --filter epos-printer-react-example test",
    "dev:vanilla": "vite",
    "verify": "pnpm build && pnpm lint && pnpm test && pnpm test:react",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "socket.io-client": "0.8.7"
  },
  "peerDependenciesMeta": {
    "socket.io-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.11.0",
    "@types/node": "^22.13.14",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "eslint": "^9.11.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.30.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "typedoc": "^0.26.7",
    "typescript": "^5.5.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.9",
    "socket.io-client": "0.8.7"
  },
  "private": false
}
